rules_version = '2';

// Staff must be signed in (Firebase Auth, Google Sign-In) AND their email
// must be on the allowedStaff allowlist for every operation below. Farmer
// and purchase data is open to every approved account (the field app's
// search depends on it); configuration, staff access and the admin audit
// log are admin-only (isAdmin below).
service cloud.firestore {
  match /databases/{database}/documents {

    function isApprovedStaff() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/allowedStaff/$(request.auth.token.email));
    }

    // True only for a staff account whose OWN allowedStaff document has
    // role == 'admin' (bootstrapped manually via Console - see
    // docs/Config-Management.md "Staff account provisioning"). Lets an
    // admin approve/reject signupRequests and create new allowedStaff
    // entries from within the app itself, instead of every approval
    // needing a Console edit.
    function isAdmin() {
      return isApprovedStaff()
        && get(/databases/$(database)/documents/allowedStaff/$(request.auth.token.email)).data.role == 'admin';
    }

    // Admin-managed allowlist of approved staff emails, keyed by email
    // address. A signed-in user may always read their OWN entry (to check
    // their own approval status); an admin may additionally read ANY
    // entry - needed to check whether an allowedStaff doc already exists
    // for a given email before approving a signupRequests entry for it
    // (see adminApprovals.js approveRequest) - and create new entries.
    //
    // Since v0.10.0 an admin can also list the roster, change another
    // account's role, and revoke another account's access (delete) from the
    // management app's Settings -> Staff access (Backlog 2.18). Never their
    // OWN document: an admin cannot demote or revoke themselves, so a
    // mis-click can't lock the last admin out - that stays a Console fix.
    match /allowedStaff/{email} {
      allow get: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin();
      // A signed-in user may update ONLY their own fcmTokens array (to
      // register/unregister this device for push notifications - see
      // docs/Push-Notifications.md) and nothing else on their own
      // document. role/addedAt stay immutable from the client either way,
      // so this can never be used to self-grant admin.
      allow update: if (request.auth != null && request.auth.token.email == email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']))
        || (isAdmin() && request.auth.token.email != email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'roleUpdatedAt', 'roleUpdatedBy']));
      allow delete: if isAdmin() && request.auth.token.email != email;
    }

    // Created by a signed-in-but-unapproved user for themselves the first
    // time they're turned away (see public/js/lib/auth.js
    // recordSignupRequest), so an admin can see and act on it from
    // /admin/approvals. Only an admin can list the pending queue or
    // resolve (update) a request; a user may always read their own.
    match /signupRequests/{email} {
      allow get: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.token.email == email;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /farmers/{frn} {
      allow read: if isApprovedStaff();
      allow create: if isApprovedStaff()
        && request.resource.data.keys().hasAll(['frn', 'fullName', 'phone']);
      allow update: if isApprovedStaff();
      allow delete: if false;
    }

    // Append-only audit trail of staff edits to farmer records (see
    // docs/Database-Schema.md "farmerEdits" and db.js updateFarmer).
    // Nothing in the field app reads these back - they exist for the
    // future desktop/admin app - but read is allowed so that app can use
    // the same staff credentials. Deliberately NO update or delete: an
    // audit log that can be rewritten after the fact isn't one.
    match /farmerEdits/{editId} {
      allow read: if isApprovedStaff();
      allow create: if isApprovedStaff()
        && request.resource.data.keys().hasAll(['frn', 'changes', 'editedBy']);
      allow update, delete: if false;
    }

    // Append-only audit trail of MANAGEMENT edits to purchases, written by
    // the admin app (admin/js/lib/data.js updatePurchaseAsAdmin). Same
    // reasoning as farmerEdits: a purchase is a financial record, so a
    // correction must leave a trail that cannot later be rewritten.
    match /purchaseEdits/{editId} {
      allow read: if isApprovedStaff();
      allow create: if isApprovedStaff()
        && request.resource.data.keys().hasAll(['purchaseId', 'changes', 'editedBy']);
      allow update, delete: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if isApprovedStaff();
      allow create: if isApprovedStaff()
        && request.resource.data.keys().hasAll(['frn', 'product', 'weightKg', 'totalUgx']);
      // Update is needed for the reconciliation flow (resolving a
      // frnUnverified purchase once the correct farmer is confirmed).
      allow update: if isApprovedStaff();
      allow delete: if false;
    }

    // Retired: FRN minting no longer uses a shared server-side counter
    // (see docs/Database-Schema.md "devices/{deviceCode}"). Left in place,
    // unused, rather than deleted, in case any historical doc needs reading.
    match /counters/{counterId} {
      allow read: if isApprovedStaff();
      allow write: if false;
    }

    // Each device claims its own randomly-generated short code once, the
    // first time it has a connection (see device.js). create-only (not
    // update) so a device can never overwrite another device's
    // registration - if two devices happen to roll the same code, the
    // second device's claim is silently rejected (accepted low-probability
    // risk, not auto-recovered - see Risk-Register).
    match /devices/{deviceCode} {
      allow read: if isApprovedStaff();
      allow create: if isApprovedStaff();
      allow update, delete: if false;
    }

    // Admin-editable reference data (see docs/Database-Schema.md and
    // docs/Config-Management.md "Editing reference data") - drives the
    // Buy Produce and New Farmer forms' dropdown/choice options and, for
    // newFarmerFields, the New Farmer form's field set itself. Read-only
    // for the field app. Admins add and edit entries from the management
    // app's Settings screen (v0.10.0). Never deleted: an entry is retired by
    // setting active: false, because old purchases and farmers still carry
    // its id and must keep rendering.
    match /products/{productId} {
      allow read: if isApprovedStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /grades/{gradeId} {
      allow read: if isApprovedStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /paymentMethods/{methodId} {
      allow read: if isApprovedStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /farmSizes/{sizeId} {
      allow read: if isApprovedStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /districts/{districtId} {
      allow read: if isApprovedStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /newFarmerFields/{fieldId} {
      allow read: if isApprovedStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Append-only log of management actions that aren't a farmer or
    // purchase edit - imports, merges, deactivations, settings and staff
    // changes (v0.10.0, written by admin/js/lib/audit.js). Admin-only both
    // ways, and like the other audit collections never rewritable.
    match /adminAudit/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['action', 'by', 'at']);
      allow update, delete: if false;
    }

    // Deliberately the ONE collection readable with no sign-in at all -
    // it powers the office picker on the Login screen itself, which by
    // definition has to render before anyone is authenticated. Contains
    // nothing but office display names/ordering; never put anything more
    // sensitive in here. See docs/Database-Schema.md "fieldOffices" and
    // docs/Risk-Register.md.
    match /fieldOffices/{officeId} {
      allow read: if true;
      // An admin can add a brand-new office from within the field app (see
      // addOffice.js), and rename, reorder or deactivate one from the
      // management app's Settings (v0.10.0). Never deleted - its id is the
      // office account's sign-in identity and appears on old records.
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
